{
  "name": "polr",
  "type": "module",
  "version": "3.0.0",
  "description": "Minimalist URL shortening platform powered by Node.js 26, TypeScript, Hono, and PostgreSQL.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.test.json && tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.14",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
