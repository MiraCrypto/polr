# Required Deployment Identity & Database
APP_NAME=Polr
APP_PROTOCOL=http://
APP_ADDRESS=localhost:3000
APP_KEY=replace-with-random-32-byte-secret-key
DATABASE_URL=postgres://polr:password@127.0.0.1:5432/polr

# Optional HTTP Listener & Short Link Tuning (defaults shown)
PORT=3000
HOST=127.0.0.1
POLR_BASE=62
POLR_SECRET_BYTES=2
_API_KEY_LENGTH=15

# Optional Access Control & Routing Policies (defaults shown)
SETTING_PUBLIC_INTERFACE=true
SETTING_SHORTEN_PERMISSION=false
SETTING_REDIRECT_404=false
SETTING_INDEX_REDIRECT=
