# HTTP Server Binding
PORT=3000
HOST=127.0.0.1

# Application Identity & Signing Key
APP_NAME=Polr
APP_PROTOCOL=http://
APP_ADDRESS=localhost:3000
APP_KEY=replace-with-random-32-byte-secret-key

# PostgreSQL Connection URI
DATABASE_URL=postgres://polr:password@127.0.0.1:5432/polr

# Short Link Generation Parameters
# POLR_BASE must be 32 (case-insensitive 0-9a-v) or 62 (case-sensitive 0-9a-zA-Z)
POLR_BASE=62
POLR_SECRET_BYTES=2
_API_KEY_LENGTH=15

# Access Control & Routing Policies
SETTING_PUBLIC_INTERFACE=true
SETTING_SHORTEN_PERMISSION=false
SETTING_INDEX_REDIRECT=
SETTING_REDIRECT_404=false

# About Page Metadata
POLR_VERSION=3.0.0
POLR_RELDATE=October 27, 2026
POLR_GENERATED_AT=October 27, 2026

